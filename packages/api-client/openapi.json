{
  "components": {
    "schemas": {
      "AccessDto": {
        "properties": {
          "action": {
            "enum": ["task.read", "content.write", "review", "file.download"],
            "type": "string"
          }
        },
        "required": ["action"],
        "type": "object"
      },
      "ActiveDto": {
        "properties": {
          "active": {
            "type": "boolean"
          }
        },
        "required": ["active"],
        "type": "object"
      },
      "AuditDto": {
        "properties": {
          "action": {
            "type": "string"
          },
          "actorId": {
            "nullable": true,
            "type": "string"
          },
          "context": {
            "additionalProperties": true,
            "type": "object"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "occurredAt": {
            "format": "date-time",
            "type": "string"
          },
          "outcome": {
            "type": "string"
          },
          "requestId": {
            "format": "uuid",
            "type": "string"
          },
          "resourceId": {
            "nullable": true,
            "type": "string"
          }
        },
        "required": [
          "context",
          "id",
          "occurredAt",
          "actorId",
          "action",
          "resourceId",
          "outcome",
          "requestId"
        ],
        "type": "object"
      },
      "ConfigureTaskDto": {
        "properties": {
          "expectedRevision": {
            "minimum": 1,
            "type": "integer"
          },
          "requirements": {
            "$ref": "#/components/schemas/RequirementsDto"
          }
        },
        "required": ["expectedRevision", "requirements"],
        "type": "object"
      },
      "CreateTaskDto": {
        "properties": {
          "eventId": {
            "format": "uuid",
            "type": "string"
          },
          "handlerMemberId": {
            "format": "uuid",
            "type": "string"
          },
          "organizationId": {
            "format": "uuid",
            "type": "string"
          },
          "reviewerMemberId": {
            "format": "uuid",
            "type": "string"
          },
          "title": {
            "maxLength": 160,
            "type": "string"
          }
        },
        "required": [
          "organizationId",
          "handlerMemberId",
          "reviewerMemberId",
          "eventId",
          "title"
        ],
        "type": "object"
      },
      "DirectoryDto": {
        "properties": {
          "members": {
            "items": {
              "$ref": "#/components/schemas/MemberChoiceDto"
            },
            "type": "array"
          },
          "organizations": {
            "items": {
              "$ref": "#/components/schemas/OrganizationChoiceDto"
            },
            "type": "array"
          },
          "users": {
            "items": {
              "$ref": "#/components/schemas/PersonDto"
            },
            "type": "array"
          }
        },
        "required": ["users", "organizations", "members"],
        "type": "object"
      },
      "EventInputDto": {
        "properties": {
          "description": {
            "maxLength": 2000,
            "type": "string"
          },
          "name": {
            "maxLength": 120,
            "type": "string"
          }
        },
        "required": ["name", "description"],
        "type": "object"
      },
      "EventViewDto": {
        "properties": {
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "description": {
            "maxLength": 2000,
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "name": {
            "maxLength": 120,
            "type": "string"
          }
        },
        "required": ["name", "description", "id", "createdAt"],
        "type": "object"
      },
      "GrantDto": {
        "properties": {
          "eventId": {
            "format": "uuid",
            "type": "string"
          },
          "memberId": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": ["eventId", "memberId"],
        "type": "object"
      },
      "HealthDto": {
        "properties": {
          "service": {
            "enum": ["caau-api"],
            "type": "string"
          },
          "status": {
            "enum": ["ok"],
            "type": "string"
          }
        },
        "required": ["status", "service"],
        "type": "object"
      },
      "IdDto": {
        "properties": {
          "id": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": ["id"],
        "type": "object"
      },
      "MaterialRequirementDto": {
        "properties": {
          "acceptanceStandard": {
            "maxLength": 2000,
            "type": "string"
          },
          "deadline": {
            "format": "date-time",
            "type": "string"
          },
          "formats": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "instructions": {
            "maxLength": 2000,
            "type": "string"
          },
          "maxBytes": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer"
          },
          "required": {
            "type": "boolean"
          },
          "templateVersion": {
            "maxLength": 120,
            "type": "string"
          },
          "title": {
            "maxLength": 160,
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "required",
          "instructions",
          "templateVersion",
          "formats",
          "maxBytes",
          "deadline",
          "acceptanceStandard"
        ],
        "type": "object"
      },
      "MemberChoiceDto": {
        "properties": {
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "organizationId": {
            "format": "uuid",
            "type": "string"
          },
          "role": {
            "enum": ["EVENT_MANAGER", "ORGANIZER", "REVIEWER", "SYSTEM_ADMIN"],
            "type": "string"
          },
          "userId": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": ["id", "userId", "organizationId", "role"],
        "type": "object"
      },
      "MemberDto": {
        "properties": {
          "organizationId": {
            "format": "uuid",
            "type": "string"
          },
          "role": {
            "enum": ["EVENT_MANAGER", "ORGANIZER", "REVIEWER", "SYSTEM_ADMIN"],
            "type": "string"
          },
          "userId": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": ["userId", "organizationId", "role"],
        "type": "object"
      },
      "NotReadyDto": {
        "properties": {
          "code": {
            "enum": ["DATABASE_UNAVAILABLE"],
            "type": "string"
          },
          "service": {
            "enum": ["caau-api"],
            "type": "string"
          },
          "status": {
            "enum": ["not_ready"],
            "type": "string"
          }
        },
        "required": ["status", "service", "code"],
        "type": "object"
      },
      "OrganizationChoiceDto": {
        "properties": {
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": ["id", "name"],
        "type": "object"
      },
      "OrganizationDto": {
        "properties": {
          "name": {
            "maxLength": 120,
            "type": "string"
          }
        },
        "required": ["name"],
        "type": "object"
      },
      "PersonDto": {
        "properties": {
          "displayName": {
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": ["id", "displayName"],
        "type": "object"
      },
      "ReadyDto": {
        "properties": {
          "service": {
            "enum": ["caau-api"],
            "type": "string"
          },
          "status": {
            "enum": ["ready"],
            "type": "string"
          }
        },
        "required": ["status", "service"],
        "type": "object"
      },
      "RequirementsDto": {
        "properties": {
          "deadline": {
            "format": "date-time",
            "type": "string"
          },
          "materials": {
            "items": {
              "$ref": "#/components/schemas/MaterialRequirementDto"
            },
            "maxItems": 50,
            "minItems": 1,
            "type": "array"
          }
        },
        "required": ["deadline", "materials"],
        "type": "object"
      },
      "ReviewerDto": {
        "properties": {
          "reviewerGrantId": {
            "format": "uuid",
            "nullable": true,
            "type": "string"
          }
        },
        "required": ["reviewerGrantId"],
        "type": "object"
      },
      "RevisionDto": {
        "properties": {
          "expectedRevision": {
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": ["expectedRevision"],
        "type": "object"
      },
      "TaskDto": {
        "properties": {
          "eventId": {
            "format": "uuid",
            "type": "string"
          },
          "handlerGrantId": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": ["eventId", "handlerGrantId"],
        "type": "object"
      },
      "TaskViewDto": {
        "properties": {
          "eventId": {
            "format": "uuid",
            "type": "string"
          },
          "handlerMemberId": {
            "format": "uuid",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "organizationId": {
            "format": "uuid",
            "type": "string"
          },
          "publishedAt": {
            "format": "date-time",
            "nullable": true,
            "type": "string"
          },
          "requirementVersion": {
            "nullable": true,
            "type": "integer"
          },
          "requirements": {
            "allOf": [
              {
                "$ref": "#/components/schemas/RequirementsDto"
              }
            ],
            "nullable": true,
            "type": "object"
          },
          "reviewerMemberId": {
            "format": "uuid",
            "type": "string"
          },
          "revision": {
            "type": "integer"
          },
          "state": {
            "enum": ["DRAFT", "PUBLISHED"],
            "type": "string"
          },
          "title": {
            "maxLength": 160,
            "type": "string"
          }
        },
        "required": [
          "organizationId",
          "handlerMemberId",
          "reviewerMemberId",
          "eventId",
          "title",
          "id",
          "state",
          "revision",
          "requirements",
          "requirementVersion",
          "publishedAt"
        ],
        "type": "object"
      },
      "UpdateAssignmentDto": {
        "properties": {
          "expectedRevision": {
            "minimum": 1,
            "type": "integer"
          },
          "handlerMemberId": {
            "format": "uuid",
            "type": "string"
          },
          "organizationId": {
            "format": "uuid",
            "type": "string"
          },
          "reviewerMemberId": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "organizationId",
          "handlerMemberId",
          "reviewerMemberId",
          "expectedRevision"
        ],
        "type": "object"
      },
      "UserDto": {
        "properties": {
          "displayName": {
            "maxLength": 80,
            "type": "string"
          }
        },
        "required": ["displayName"],
        "type": "object"
      },
      "WorkspaceIdentityDto": {
        "properties": {
          "displayName": {
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "roles": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": ["id", "displayName", "roles"],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearer": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "contact": {},
    "description": "Health, local identity, events and material-task preparation/publication. No material upload, submission, review or WeChat login.",
