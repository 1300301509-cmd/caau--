{
  "components": {
    "schemas": {
      "AccessDto": {
        "properties": {
          "action": {
            "enum": ["task.read", "content.write", "review", "file.download"],
            "type": "string"
          }
        },
        "required": ["action"],
        "type": "object"
      },
      "ActiveDto": {
        "properties": {
          "active": {
            "type": "boolean"
          }
        },
        "required": ["active"],
        "type": "object"
      },
      "AuditDto": {
        "properties": {
          "action": {
            "type": "string"
          },
          "actorId": {
            "nullable": true,
            "type": "string"
          },
          "context": {
            "additionalProperties": true,
            "type": "object"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "occurredAt": {
            "format": "date-time",
            "type": "string"
          },
          "outcome": {
            "type": "string"
          },
          "requestId": {
            "format": "uuid",
            "type": "string"
          },
          "resourceId": {
            "nullable": true,
            "type": "string"
          }
        },
        "required": [
          "context",
          "id",
          "occurredAt",
          "actorId",
          "action",
          "resourceId",
          "outcome",
          "requestId"
        ],
        "type": "object"
      },
      "GrantDto": {
        "properties": {
          "eventId": {
            "format": "uuid",
            "type": "string"
          },
          "memberId": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": ["eventId", "memberId"],
        "type": "object"
      },
      "HealthDto": {
        "properties": {
          "service": {
            "enum": ["caau-api"],
            "type": "string"
          },
          "status": {
            "enum": ["ok"],
            "type": "string"
          }
        },
        "required": ["status", "service"],
        "type": "object"
      },
      "IdDto": {
        "properties": {
          "id": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": ["id"],
        "type": "object"
      },
      "MemberDto": {
        "properties": {
          "organizationId": {
            "format": "uuid",
            "type": "string"
          },
          "role": {
            "enum": ["EVENT_MANAGER", "ORGANIZER", "REVIEWER", "SYSTEM_ADMIN"],
            "type": "string"
          },
          "userId": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": ["userId", "organizationId", "role"],
        "type": "object"
      },
      "NotReadyDto": {
        "properties": {
          "code": {
            "enum": ["DATABASE_UNAVAILABLE"],
            "type": "string"
          },
          "service": {
            "enum": ["caau-api"],
            "type": "string"
          },
          "status": {
            "enum": ["not_ready"],
            "type": "string"
          }
        },
        "required": ["status", "service", "code"],
        "type": "object"
      },
      "OrganizationDto": {
        "properties": {
          "name": {
            "maxLength": 120,
            "type": "string"
          }
        },
        "required": ["name"],
        "type": "object"
      },
      "ReadyDto": {
        "properties": {
          "service": {
            "enum": ["caau-api"],
            "type": "string"
          },
          "status": {
            "enum": ["ready"],
            "type": "string"
          }
        },
        "required": ["status", "service"],
        "type": "object"
      },
      "ReviewerDto": {
        "properties": {
          "reviewerGrantId": {
            "format": "uuid",
            "nullable": true,
            "type": "string"
          }
        },
        "required": ["reviewerGrantId"],
        "type": "object"
      },
      "TaskDto": {
        "properties": {
          "eventId": {
            "format": "uuid",
            "type": "string"
          },
          "handlerGrantId": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": ["eventId", "handlerGrantId"],
        "type": "object"
      },
      "UserDto": {
        "properties": {
          "displayName": {
            "maxLength": 80,
            "type": "string"
          }
        },
        "required": ["displayName"],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearer": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "contact": {},
    "description": "Health and authorization foundation. Local test identity only; no material workflow or WeChat login.",
