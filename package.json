{
  "name": "caau",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": "24.19.x",
    "pnpm": "10.32.1"
  },
  "scripts": {
    "check": "node scripts/check-doc-links.mjs && prettier --check package.json pnpm-workspace.yaml .prettierrc.json scripts/*.mjs && node --test scripts/*.test.mjs",
    "check:docs": "node scripts/check-doc-links.mjs",
    "check:format": "prettier --check package.json pnpm-workspace.yaml .prettierrc.json scripts/*.mjs",
    "test:tooling": "node --test scripts/*.test.mjs"
  },
  "devDependencies": {
    "prettier": "3.6.2"
  }
}
