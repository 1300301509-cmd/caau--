# Local-only defaults. No real credentials or business configuration.
# For the local database use `corepack pnpm db:setup`, `db:up`, then `db:api`.
# db:api injects only the runtime app DATABASE_URL from ignored .local/db/dev.env.
# Without DATABASE_URL: health=200, ready=503. Never use the migration-owner URL here.
# Opt in only for local synthetic sessions; forbidden in production/external HOST.
CAAU_IDENTITY_MODE=disabled
# Deployed test server only: NODE_ENV=production, CAAU_DEPLOYMENT_STAGE=test,
# CAAU_IDENTITY_MODE=server-test and HTTPS CORS origins. Production must remain disabled.
CAAU_DEPLOYMENT_STAGE=local
HOST=127.0.0.1
PORT=3000
CORS_ORIGINS=http://127.0.0.1:5175,http://localhost:5175,http://127.0.0.1:4173

# Optional server-only private object root; never expose through a static route.
# CAAU_PRIVATE_FILE_ROOT=/absolute/private/directory

# Formal Mini Program login. Set both only in a secret-managed server environment.
# Never place the AppSecret in miniapp source, public environment variables or Git.
# CAAU_WECHAT_MINIAPP_APP_ID=wx...
# CAAU_WECHAT_MINIAPP_APP_SECRET=managed-outside-git
