# Local-only defaults. No real credentials or business configuration.
# For the local database use `corepack pnpm db:setup`, `db:up`, then `db:api`.
# db:api injects only the runtime app DATABASE_URL from ignored .local/db/dev.env.
# Without DATABASE_URL: health=200, ready=503. Never use the migration-owner URL here.
HOST=127.0.0.1
PORT=3000
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173
