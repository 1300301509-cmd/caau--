# Structure only; DO NOT use these placeholders as actual credentials.
# db:setup creates distinct random dev/test owner and app secrets under .local/db/.
DATABASE_URL=postgresql://APP_USER:APP_PASSWORD@127.0.0.1:15432/caau_dev
MIGRATION_DATABASE_URL=postgresql://OWNER_USER:OWNER_PASSWORD@127.0.0.1:15432/caau_dev
SHADOW_DATABASE_URL=postgresql://OWNER_USER:OWNER_PASSWORD@127.0.0.1:15432/caau_dev_shadow
# Test uses another container/volume/network/account and host port 15433, database caau_test.
