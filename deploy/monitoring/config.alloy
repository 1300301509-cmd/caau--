otelcol.receiver.otlp "caau" {
  http { endpoint = "0.0.0.0:4318" }
  output { traces = [otelcol.processor.batch.caau.input] }
}
otelcol.processor.batch "caau" {
  timeout = "2s"
  output { traces = [otelcol.exporter.otlphttp.tempo.input] }
}
otelcol.exporter.otlphttp "tempo" {
  client { endpoint = "http://tempo:4318" }
}
loki.source.file "caau" {
  targets = [{__path__ = "/var/log/caau/*.jsonl", app = "caau-api"}]
  forward_to = [loki.process.timestamps.receiver]
  file_match {
    enabled = true
    sync_period = "5s"
    ignore_older_than = "720h"
  }
}
loki.process "timestamps" {
  stage.json { expressions = {timestamp = "at"} }
  stage.timestamp {
    source = "timestamp"
    format = "RFC3339Nano"
    action_on_failure = "skip"
  }
  forward_to = [loki.write.local.receiver]
}
loki.write "local" {
  endpoint { url = "http://loki:3100/loki/api/v1/push" }
}
